  "cards": [
    {
      "dot": "cyan",
      "title": "One Core, many Bridges",
      "items": [
        "Every Bridge receives image + question from its Agent",
        "Hermes and MCP import the Core in-process",
        "dsh native spawns cli.py with a Base64 stdin envelope"
      ]
    },
    {
      "dot": "violet",
      "title": "Two delivery legs",
      "items": [
        "npm leg: CI publishes vision-translation-dsh@X.Y.Z → dsh plugin add",
        "git leg: hermes plugins update refreshes the Hermes plugin copy",
        "A release is complete only after both legs refresh"
      ]
    },
    {
      "dot": "slate",
      "title": "Bridge rules",
      "items": [
        "Bridges never copy Core logic",
        "stdout stays pure JSON; logs go to stderr",
        "status ok / unavailable / error maps to host results"
      ]
    }
